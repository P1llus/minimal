#!/bin/bash
# /init of the probe guest that tests/uplink_boot_integration.rs boots through
# minvmd. It stands in for the guest daemon's network setup: a bridge on the
# VM's network device and one "box" namespace on a veth. It then serves a page
# and a shell from inside the box, so the test can reach the box through a
# published port and run checks in it.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
mkdir -p /proc /sys /dev /tmp /run /etc /www
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mount -t tmpfs tmpfs /tmp
mount -t tmpfs tmpfs /run
mkdir -p /run/netns
exec >/dev/console 2>&1

NODE=100.64.255.253 GW=100.64.0.1 GW_MAC=5a:94:ef:e4:0c:dd
# The first address the VM host hands a registered box, and its derived MAC.
BOX=100.64.127.255 BOX_MAC=52:54:00:40:7f:ff

echo "PROBE cmdline: $(cat /proc/cmdline)"
ip link set lo up
if ! ip link show eth0 >/dev/null 2>&1; then
  echo "PROBE uplink: no network device"
else
  echo "PROBE uplink: eth0 mac $(cat /sys/class/net/eth0/address)"
  # The bridge keeps one MAC, and the uplink port neither learns nor floods:
  # the gateway is the only address behind it.
  ip link add br0 address "$(cat /sys/class/net/eth0/address)" type bridge stp_state 0 forward_delay 0 mcast_snooping 0
  ip link set eth0 master br0
  bridge link set dev eth0 learning off flood off mcast_flood off
  ip link set eth0 up
  bridge fdb replace $GW_MAC dev eth0 master static
  ip addr add $NODE/16 dev br0
  ip link set br0 up
  ip route add default via $GW
  echo "nameserver $GW" > /etc/resolv.conf

  ip netns add box
  ip link add vbox type veth peer name eth0 netns box address $BOX_MAC
  ip link set vbox master br0
  ip link set vbox up
  ip -n box link set lo up
  ip -n box addr add $BOX/16 dev eth0
  ip -n box link set eth0 up
  ip -n box route add default via $GW
  mkdir -p /etc/netns/box; echo "nameserver $GW" > /etc/netns/box/resolv.conf

  echo "probe box page" > /www/index.html
  ip netns exec box busybox httpd -p 8080 -h /www
  ip netns exec box socat TCP-LISTEN:8022,reuseaddr,fork EXEC:/bin/bash,stderr &
fi

echo READY | socat - VSOCK-CONNECT:2:7350 && echo "PROBE ready sent"

if ip link show eth0 >/dev/null 2>&1; then
  ok() { "$@" >/dev/null 2>&1 && echo ok || echo FAIL; }
  echo "PROBE check gateway: $(ok ip netns exec box busybox ping -c1 -W2 $GW)"
  echo "PROBE check dns: $(ok ip netns exec box busybox nslookup example.com $GW)"
  echo "PROBE check internet: $(ip netns exec box curl -s -m 8 -o /dev/null -w '%{http_code}' http://example.com/)"
  echo "PROBE check gateway-api: $(ip netns exec box curl -s -m 5 -o /dev/null -w '%{http_code}' http://$GW/services/forwarder/all)"
  echo "PROBE checks done"
fi
while :; do sleep 3600; done
