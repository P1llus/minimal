             rlimits: HashMap::new(),
             #[cfg(feature = "cgroups")]
@@ -402,6 +406,17 @@ impl Container {
         self
     }
 
+    /// Moves the container into an existing cgroup. `dir` is an open cgroup v2
+    /// directory.
+    ///
+    /// The container's first process writes itself into that cgroup before it
+    /// creates any namespace, so every process of the container starts in the
+    /// cgroup, and a new CGROUP namespace has it as its root.
+    pub fn cgroup<F: Into<OwnedFd>>(&mut self, dir: F) -> &mut Self {
+        self.cgroup = Some(Arc::new(dir.into()));
+        self
+    }
+
     /// Change the network mode in new NETWORK namespace.
     pub fn network<T: Into<Network>>(&mut self, network: T) -> &mut Self {
         self.network = Some(network.into());
diff --git a/hakoniwa/src/runc.rs b/hakoniwa/src/runc.rs
index 67c2f63..52d19ac 100644
--- a/hakoniwa/src/runc.rs
+++ b/hakoniwa/src/runc.rs
@@ -99,6 +99,11 @@ fn exec_imp(
     reader: PipeReader,
     writer: &mut Option<PipeWriter>,
 ) -> Result<ExitStatus> {
+    // Join the caller's cgroup, before anything else is set up.
+    if let Some(dir) = &container.cgroup {
+        sys::join_cgroup(dir.as_raw_fd())?;
+    }
+
     // Redirect standard I/O stream.
     if let Some(stdin) = stdin.take() {
         sys::dup2_stdin(stdin.as_raw_fd())?;
diff --git a/hakoniwa/src/runc/sys.rs b/hakoniwa/src/runc/sys.rs
index f4fe92c..1ff0c39 100644
--- a/hakoniwa/src/runc/sys.rs
+++ b/hakoniwa/src/runc/sys.rs
@@ -61,6 +61,14 @@ macro_rules! map_err {
     };
 }
 
+pub(crate) fn join_cgroup(dir: RawFd) -> Result<()> {
+    let procs = format!("/proc/self/fd/{dir}/cgroup.procs");
+    fs::write(&procs, "0").map_err(|err| {
+        let err = format!("write({procs:?}, \"0\") => {err}");
+        Error::SysError(err)
+    })
+}
+
 pub(crate) fn unshare(clone_flags: CloneFlags) -> Result<()> {
     map_err!(sched::unshare(clone_flags))
 }
