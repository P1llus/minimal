+    // A cgroup this test may create and enter: a child of its own. `None`
+    // where the host does not delegate the test's cgroup to its user.
+    fn scratch_cgroup(name: &str) -> Option<PathBuf> {
+        let own = fs::read_to_string("/proc/self/cgroup").ok()?;
+        let own = own.lines().find_map(|line| line.strip_prefix("0::"))?;
+        let dir = PathBuf::from(format!("/sys/fs/cgroup{own}"))
+            .join(format!("{name}-{}", std::process::id()));
+        fs::create_dir(&dir).ok()?;
+        Some(dir)
+    }
+
+    #[test]
+    fn test_cgroup() {
+        let Some(dir) = scratch_cgroup("hakoniwa-cgroup") else {
+            return;
+        };
+        let output = Container::new()
+            .rootfs("/")
+            .unwrap()
+            .cgroup(File::open(&dir).unwrap())
+            .command("/bin/cat")
+            .arg("/proc/self/cgroup")
+            .output()
+            .unwrap();
+        fs::remove_dir(&dir).unwrap();
+        assert!(output.status.success());
+        let name = dir.file_name().unwrap().to_string_lossy();
+        assert!(String::from_utf8_lossy(&output.stdout).ends_with(&format!("/{name}\n")));
+    }
+
+    #[test]
+    fn test_cgroup_is_the_root_of_a_new_cgroup_namespace() {
+        let Some(dir) = scratch_cgroup("hakoniwa-cgroupns") else {
+            return;
+        };
+        let output = Container::new()
+            .rootfs("/")
+            .unwrap()
+            .unshare(Namespace::Cgroup)
+            .cgroup(File::open(&dir).unwrap())
+            .command("/bin/cat")
+            .arg("/proc/self/cgroup")
+            .output()
+            .unwrap();
+        fs::remove_dir(&dir).unwrap();
+        assert!(output.status.success());
+        assert_eq!(String::from_utf8_lossy(&output.stdout), "0::/\n");
+    }
+
+    #[test]
+    fn test_cgroup_runc_error() {
+        let output = Container::new()
+            .rootfs("/")
+            .unwrap()
+            .cgroup(File::open("/proc/self").unwrap())
+            .command("/bin/true")
+            .output()
+            .unwrap();
+        assert!(!output.status.success());
+        assert_contains!(output.status.reason, "cgroup.procs");
+    }
+
     #[test]
     fn test_network_pasta() {
         let output = Container::new()
