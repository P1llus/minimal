         assert_eq!(status.rusage.unwrap().real_time.as_secs(), 1);
     }
 
+    #[test]
+    fn test_setup_timeout() {
+        // A setup that no time is left for ends the container.
+        let mut child = command("/bin/true")
+            .setup_timeout(std::time::Duration::ZERO)
+            .spawn()
+            .unwrap();
+        let status = child.wait().unwrap();
+        assert!(!status.success());
+        assert_contains!(status.reason, "setup timeout");
+
+        // One with time to spare runs.
+        let status = command("/bin/true")
+            .setup_timeout(std::time::Duration::from_secs(30))
+            .status()
+            .unwrap();
+        assert!(status.success());
+    }
+
