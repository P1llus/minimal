         crate::unshare::mainp_setup_ugidmap(&self.container, child)
diff --git a/hakoniwa/tests/command_test.rs b/hakoniwa/tests/command_test.rs
index bc5cb95..05b2713 100644
--- a/hakoniwa/tests/command_test.rs
+++ b/hakoniwa/tests/command_test.rs
