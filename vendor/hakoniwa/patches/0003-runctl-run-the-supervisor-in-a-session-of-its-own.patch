From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: minimal <noreply@minimal.dev>
Date: Wed, 11 Nov 2026 16:52:58 +0100
Subject: [PATCH] feat(runctl): run the supervisor in a session of its own

Add Runctl::SupervisorNewSession. The supervisor calls setsid(2) before
it creates the container, so no process of the container shares a
session or a process group with the caller, and a signal the container
sends to its own process group cannot reach the caller.
---
 hakoniwa/src/runc.rs             |  5 +++++
 hakoniwa/src/runctl.rs           |  8 +++++++
 hakoniwa/tests/container_test.rs | 36 +++++++++++++++++++++++++++++++-
 3 files changed, 48 insertions(+), 1 deletion(-)

diff --git a/hakoniwa/src/runc.rs b/hakoniwa/src/runc.rs
index 52d19ac..f04c117 100644
--- a/hakoniwa/src/runc.rs
+++ b/hakoniwa/src/runc.rs
@@ -104,6 +104,11 @@ fn exec_imp(
         sys::join_cgroup(dir.as_raw_fd())?;
     }
 
+    // Leave the caller's session and process group.
+    if container.runctl.contains(&Runctl::SupervisorNewSession) {
+        sys::setsid()?;
+    }
+
     // Redirect standard I/O stream.
     if let Some(stdin) = stdin.take() {
         sys::dup2_stdin(stdin.as_raw_fd())?;
diff --git a/hakoniwa/src/runctl.rs b/hakoniwa/src/runctl.rs
index 7e2c351..5e1073d 100644
--- a/hakoniwa/src/runctl.rs
+++ b/hakoniwa/src/runctl.rs
@@ -33,4 +33,12 @@ pub enum Runctl {
 
     /// Mount root dir with read-write access.
     RootdirRW,
+
+    /// Run the container's supervisor process in a session of its own.
+    ///
+    /// The supervisor calls `setsid(2)` before it creates the container, so
+    /// neither it nor the internal process shares a session or a process
+    /// group with the caller. A signal the container sends to its own
+    /// process group, such as `kill(0, sig)`, then cannot reach the caller.
+    SupervisorNewSession,
 }
