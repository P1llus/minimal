+    #[test]
+    fn test_runctl_supervisor_new_session() {
+        // Field 5 of /proc/<pid>/stat is the process group, field 6 the session.
+        let ids = |stat: &str| -> (String, String) {
+            let rest = stat.rsplit_once(')').unwrap().1;
+            let fields: Vec<&str> = rest.split_whitespace().collect();
+            (fields[2].to_string(), fields[3].to_string())
+        };
+        let own = ids(&fs::read_to_string("/proc/self/stat").unwrap());
+
+        let stat_of = |supervisor_new_session: bool| {
+            let mut container = Container::new();
+            container.rootfs("/").unwrap();
+            if supervisor_new_session {
+                container.runctl(Runctl::SupervisorNewSession);
+            }
+            let mut child = container
+                .command("/bin/sleep")
+                .arg("5")
+                .stdout(Stdio::MakePipe)
+                .spawn()
+                .unwrap();
+            let stat = fs::read_to_string(format!("/proc/{}/stat", child.id())).unwrap();
+            child.kill().unwrap();
+            child.wait().unwrap();
+            (ids(&stat), child.id().to_string())
+        };
+
+        let (shared, _) = stat_of(false);
+        assert_eq!(shared, own);
+        let (detached, supervisor) = stat_of(true);
+        assert_eq!(detached, (supervisor.clone(), supervisor));
+    }
+
