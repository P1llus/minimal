         })
     }
 
@@ -164,6 +168,7 @@ impl UnixProxy {
             push_cnt: Wrapping(0),
             path: Default::default(),
             outstanding: VecDeque::new(),
+            host_eof: false,
         }
     }
 
@@ -211,6 +216,62 @@ impl UnixProxy {
         push_packet(self.cid, rx, &self.rxq, &self.queue, &self.mem);
     }
 
+    /// Tell the guest that the host side will send no more data. The guest
+    /// reads what was delivered, then end of file, and can still send.
+    fn push_shutdown_send(&self) {
+        debug!(
+            "push_shutdown_send: id: {}, peer_port: {}, local_port: {}",
+            self.id, self.peer_port, self.local_port
+        );
+
+        let rx = MuxerRx::Shutdown {
+            local_port: self.local_port,
+            peer_port: self.peer_port,
+            flags: uapi::VSOCK_FLAGS_SHUTDOWN_SEND,
+            // The guest takes its send credit from every packet's header.
+            fwd_cnt: self.tx_cnt.0,
+        };
+
+        push_packet(self.cid, rx, &self.rxq, &self.queue, &self.mem);
+    }
+
+    /// The host side's stream has been read to its end. If the host socket
+    /// hung up, or the guest has already stopped sending, nothing can flow
+    /// in either direction and the connection is reset. Otherwise only the
+    /// guest's receive direction ends.
+    fn host_ended(&mut self, hung_up: bool, mut update: ProxyUpdate) -> ProxyUpdate {
+        let guest_done_sending = self.peer_shutdown & uapi::VSOCK_FLAGS_SHUTDOWN_SEND != 0;
+
+        if hung_up || guest_done_sending {
+            debug!("host_ended: sending reset: id={}", self.id);
+            self.push_reset();
+            self.status = ProxyStatus::Closed;
+            if hung_up {
+                update.remove_proxy = ProxyRemoval::Deferred;
+            }
+        } else {
+            debug!("host_ended: sending shutdown: id={}", self.id);
+            self.push_shutdown_send();
+        }
+
+        // End of file stays readable, so stop polling for it.
+        update.polling = Some((self.id, self.fd.as_raw_fd(), EventSet::empty()));
+        update.signal_queue = true;
+        update
+    }
+
+    /// The host socket refused data from the guest after the host side had
+    /// ended its own stream: the host closed completely. Reset the guest.
+    fn host_gone(&mut self) -> ProxyUpdate {
+        self.push_reset();
+        self.status = ProxyStatus::Closed;
+        ProxyUpdate {
+            signal_queue: true,
+            remove_proxy: ProxyRemoval::Deferred,
+            ..Default::default()
+        }
+    }
+
     fn peer_avail_credit(&self) -> usize {
         (Wrapping(self.peer_buf_alloc) - (self.rx_cnt - self.peer_fwd_cnt)).0 as usize
     }
@@ -327,7 +388,7 @@ impl UnixProxy {
                         pkt.hdr().len() + cnt
                     }
