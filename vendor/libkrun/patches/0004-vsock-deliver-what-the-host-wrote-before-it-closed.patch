+        }
+
         self.status = ProxyStatus::Connected;
 
         ProxyUpdate {
@@ -607,7 +677,11 @@ impl Proxy for UnixProxy {
         self.peer_shutdown |= shutdown;
         self.do_shutdown(pkt);
 
-        if self.peer_shutdown != SHUTDOWN_MASK {
