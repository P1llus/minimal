+        let both_ended =
+            self.host_eof && self.peer_shutdown & uapi::VSOCK_FLAGS_SHUTDOWN_SEND != 0;
+        if self.peer_shutdown != SHUTDOWN_MASK && !both_ended {
             return ProxyUpdate::default();
         }
 
@@ -643,7 +717,17 @@ impl Proxy for UnixProxy {
     fn process_event(&mut self, evset: EventSet) -> ProxyUpdate {
         let mut update = ProxyUpdate::default();
 
-        if evset.contains(EventSet::HANG_UP) {
+        // A connected proxy whose host socket hung up may still hold data the
+        // host wrote before it closed. It is read to the end below, like any
+        // readable socket, and the connection ends once the read returns end
+        // of file. A proxy that waits for credit is not polled, and reads the
+        // rest when its credit arrives.
+        let draining = matches!(
+            self.status,
+            ProxyStatus::Connected | ProxyStatus::WaitingCreditUpdate
+        );
+
+        if evset.contains(EventSet::HANG_UP) && !draining {
             debug!("process_event: HANG_UP");
 
             if self.status == ProxyStatus::Connecting {
@@ -660,7 +744,7 @@ impl Proxy for UnixProxy {
             return update;
         }
 
-        if evset.contains(EventSet::IN) {
+        if evset.intersects(EventSet::IN | EventSet::HANG_UP) {
             debug!("process_event: IN");
             if self.status == ProxyStatus::Connected {
                 let (signal_queue, wait_credit) = self.recv_pkt();
@@ -686,16 +770,8 @@ impl Proxy for UnixProxy {
                     update.signal_queue = true;
                 }
 
-                if self.status == ProxyStatus::Closed {
-                    debug!(
-                        "process_event: endpoint closed, sending reset: id={}",
-                        self.id
-                    );
-
-                    self.push_reset();
-                    update.signal_queue = true;
-                    update.polling = Some((self.id(), self.fd.as_raw_fd(), EventSet::empty()));
-                    return update;
+                if self.host_eof {
+                    return self.host_ended(evset.contains(EventSet::HANG_UP), update);
                 } else if self.status == ProxyStatus::WaitingCreditUpdate {
                     debug!("process_event: WaitingCreditUpdate");
                     update.polling = Some((self.id(), self.fd.as_raw_fd(), EventSet::empty()));
