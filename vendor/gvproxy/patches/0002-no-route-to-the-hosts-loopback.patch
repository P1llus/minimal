+// A configuration that names no NAT entry and no virtual address gets
+// neither, with a config file and without one.
+func TestNoDefaultRouteToTheHostsLoopback(t *testing.T) {
+	t.Parallel()
+	for _, argv := range [][]string{{}, {"-config", "unused.yaml"}} {
+		var cnf GvproxyConfig
+		var args GvproxyArgs
+		flagSet := flag.NewFlagSet(os.Args[0], flag.ContinueOnError)
+		_, err := GvproxyArgParse(flagSet, &args, argv)
+		require.NoError(t, err)
+		require.NoError(t, yaml.Unmarshal([]byte("stack:\n    subnet: 100.64.0.0/16\n"), &cnf))
+		got, err := GvproxyConfigure(&cnf, &args, "testing")
+		require.NoError(t, err)
+		assert.Equal(t, "100.64.255.254", got.Stack.HostIP)
+		assert.Empty(t, got.Stack.NAT, "args %v", argv)
+		assert.Empty(t, got.Stack.GatewayVirtualIPs, "args %v", argv)
+	}
+}
