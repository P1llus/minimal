diff --git a/pkg/services/forwarder/this_host.go b/pkg/services/forwarder/this_host.go
new file mode 100644
index 000000000000..703d54443eb9
--- /dev/null
+++ b/pkg/services/forwarder/this_host.go
@@ -0,0 +1,17 @@
+// Added by gominimal/minimal (vendor/gvproxy/patches/0002).
+
+package forwarder
+
+import (
+	"gvisor.dev/gvisor/pkg/tcpip"
+	"gvisor.dev/gvisor/pkg/tcpip/header"
+)
+
+// dialsThisHost reports whether a dial to address from this process ends at
+// the host itself: a loopback address, or the unspecified address, which
+// connect(2) takes as this host. The forwarders refuse such a destination
+// after NAT translation, so no frame and no NAT entry reaches a service
+// that listens on the host's loopback.
+func dialsThisHost(address tcpip.Address) bool {
+	return address.Unspecified() || header.IsV4LoopbackAddress(address)
+}
diff --git a/pkg/services/forwarder/this_host_test.go b/pkg/services/forwarder/this_host_test.go
new file mode 100644
index 000000000000..4fd8b682d6e6
--- /dev/null
+++ b/pkg/services/forwarder/this_host_test.go
@@ -0,0 +1,158 @@
+// Added by gominimal/minimal (vendor/gvproxy/patches/0002): proves that the
+// forwarders dial no destination that ends at the host itself.
+
+package forwarder
+
+import (
+	"context"
+	"net"
+	"sync"
+	"testing"
+	"time"
+
+	"gvisor.dev/gvisor/pkg/tcpip"
+	"gvisor.dev/gvisor/pkg/tcpip/adapters/gonet"
+	"gvisor.dev/gvisor/pkg/tcpip/header"
+	"gvisor.dev/gvisor/pkg/tcpip/link/loopback"
+	"gvisor.dev/gvisor/pkg/tcpip/network/ipv4"
+	"gvisor.dev/gvisor/pkg/tcpip/stack"
+	"gvisor.dev/gvisor/pkg/tcpip/transport/tcp"
+	"gvisor.dev/gvisor/pkg/tcpip/transport/udp"
+)
+
+func TestDialsThisHost(t *testing.T) {
+	for address, want := range map[string]bool{
+		"127.0.0.1":       true,
+		"127.0.64.2":      true,
+		"127.255.255.254": true,
+		"0.0.0.0":         true,
+		"100.64.255.254":  false,
+		"192.0.2.1":       false,
+		"128.0.0.1":       false,
+	} {
+		got := dialsThisHost(tcpip.AddrFrom4Slice(net.ParseIP(address).To4()))
+		if got != want {
+			t.Errorf("dialsThisHost(%s) = %v, want %v", address, got, want)
+		}
+	}
+}
+
+var thisHostGuest = tcpip.AddrFrom4([4]byte{100, 64, 0, 9})
+
+// forwardingStack is a gvisor stack whose one NIC hands every packet it
+// sends back in, with the TCP and UDP forwarders and the given NAT. What a
+// socket on it sends from the guest address arrives at the forwarders as a
+// guest's packet would.
+func forwardingStack(t *testing.T, nat map[tcpip.Address]tcpip.Address) *stack.Stack {
+	t.Helper()
+	s := stack.New(stack.Options{
+		NetworkProtocols:   []stack.NetworkProtocolFactory{ipv4.NewProtocol},
+		TransportProtocols: []stack.TransportProtocolFactory{tcp.NewProtocol, udp.NewProtocol},
+	})
+	if err := s.CreateNIC(1, loopback.New()); err != nil {
+		t.Fatalf("create NIC: %v", err)
+	}
+	if err := s.AddProtocolAddress(1, tcpip.ProtocolAddress{
+		Protocol:          ipv4.ProtocolNumber,
+		AddressWithPrefix: thisHostGuest.WithPrefix(),
+	}, stack.AddressProperties{}); err != nil {
+		t.Fatalf("add address: %v", err)
+	}
+	s.SetSpoofing(1, true)
+	s.SetPromiscuousMode(1, true)
+	s.SetRouteTable([]tcpip.Route{{Destination: header.IPv4EmptySubnet, NIC: 1}})
+	var natLock sync.Mutex
+	s.SetTransportProtocolHandler(tcp.ProtocolNumber, TCP(s, nat, &natLock, false, 0, time.Second).HandlePacket)
+	s.SetTransportProtocolHandler(udp.ProtocolNumber, UDP(s, nat, &natLock, false).HandlePacket)
+	t.Cleanup(s.Destroy)
+	return s
+}
+
+func sendFromGuest(t *testing.T, s *stack.Stack, dst tcpip.Address, udpPort, tcpPort uint16) {
+	t.Helper()
+	conn, err := gonet.DialUDP(s, &tcpip.FullAddress{NIC: 1, Addr: thisHostGuest},
+		&tcpip.FullAddress{NIC: 1, Addr: dst, Port: udpPort}, ipv4.ProtocolNumber)
+	if err != nil {
+		t.Fatalf("udp socket to %s: %v", dst, err)
+	}
+	defer conn.Close()
+	if _, err := conn.Write([]byte("ping")); err != nil {
+		t.Fatalf("udp send to %s: %v", dst, err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 300*time.Millisecond)
+	defer cancel()
+	stream, err := gonet.DialTCPWithBind(ctx, s, tcpip.FullAddress{NIC: 1, Addr: thisHostGuest},
+		tcpip.FullAddress{NIC: 1, Addr: dst, Port: tcpPort}, ipv4.ProtocolNumber)
+	if err == nil {
+		stream.Close()
+	}
+}
+
+// A datagram or connection for a loopback address, or for an address a NAT
+// entry maps to loopback, never arrives at a listener on the host's
+// loopback. One for the host's own non-loopback address does arrive, which
+// shows the forwarders saw the packets at all.
+func TestForwardersDialNoDestinationOnTheHostItself(t *testing.T) {
+	alias := tcpip.AddrFrom4([4]byte{100, 64, 255, 254})
+	s := forwardingStack(t, map[tcpip.Address]tcpip.Address{
+		alias: tcpip.AddrFrom4([4]byte{127, 0, 0, 1}),
+	})
+
+	udpListener, err := net.ListenUDP("udp4", &net.UDPAddr{})
+	if err != nil {
+		t.Fatalf("listen udp: %v", err)
+	}
+	defer udpListener.Close()
+	udpPort := uint16(udpListener.LocalAddr().(*net.UDPAddr).Port)
+	tcpListener, err := net.ListenTCP("tcp4", &net.TCPAddr{})
+	if err != nil {
+		t.Fatalf("listen tcp: %v", err)
+	}
+	defer tcpListener.Close()
+	tcpPort := uint16(tcpListener.Addr().(*net.TCPAddr).Port)
+
+	for _, dst := range []tcpip.Address{
+		tcpip.AddrFrom4([4]byte{127, 0, 0, 1}),
+		tcpip.AddrFrom4([4]byte{127, 0, 64, 2}),
+		alias,
+	} {
+		sendFromGuest(t, s, dst, udpPort, tcpPort)
+	}
+	_ = udpListener.SetReadDeadline(time.Now().Add(time.Second))
+	buf := make([]byte, 16)
+	if n, from, err := udpListener.ReadFrom(buf); err == nil {
+		t.Errorf("a datagram reached the host through loopback: %q from %v", buf[:n], from)
+	}
+	_ = tcpListener.SetDeadline(time.Now().Add(300 * time.Millisecond))
+	if conn, err := tcpListener.Accept(); err == nil {
+		t.Errorf("a connection reached the host through loopback from %v", conn.RemoteAddr())
+		conn.Close()
+	}
+
+	own := ownAddress()
+	if own == nil {
+		t.Log("this host has no address besides loopback, so the forwarded case did not run")
+		return
+	}
+	sendFromGuest(t, s, tcpip.AddrFrom4Slice(own), udpPort, tcpPort)
+	_ = udpListener.SetReadDeadline(time.Now().Add(3 * time.Second))
+	if _, _, err := udpListener.ReadFrom(buf); err != nil {
+		t.Errorf("no datagram for %v arrived, so the forwarders saw none of the packets: %v", own, err)
+	}
+}
+
+// ownAddress is an IPv4 address of this host that is not loopback.
+func ownAddress() net.IP {
+	addrs, err := net.InterfaceAddrs()
+	if err != nil {
+		return nil
+	}
+	for _, addr := range addrs {
+		if ipNet, ok := addr.(*net.IPNet); ok {
+			if ip := ipNet.IP.To4(); ip != nil && !ip.IsLoopback() && !ip.IsLinkLocalUnicast() {
+				return ip
+			}
+		}
+	}
+	return nil
+}
